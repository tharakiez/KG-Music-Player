from PIL import Image, ImageEnhance, ImageFilter
from pathlib import Path

src = Path("/mnt/data/26698.jpg")
img = Image.open(src).convert("RGB")

# Crop to a portrait composition that keeps the woven hat, face, necklace and shoulders.
w, h = img.size
left = int(w * 0.06)
right = int(w * 0.94)
top = int(h * 0.08)
bottom = int(h * 0.88)
crop = img.crop((left, top, right, bottom))

# Gently lift the dark portrait while retaining its natural, warm character.
crop = ImageEnhance.Brightness(crop).enhance(1.18)
crop = ImageEnhance.Contrast(crop).enhance(1.08)
crop = ImageEnhance.Color(crop).enhance(1.06)

# Fit a practical portrait asset for the app header.
target_w = 900
target_h = 1125
crop.thumbnail((target_w, target_h), Image.Resampling.LANCZOS)
canvas = Image.new("RGB", (target_w, target_h), (12, 7, 5))
x = (target_w - crop.width) // 2
y = (target_h - crop.height) // 2
canvas.paste(crop, (x, y))
out = Path("/mnt/data/kg_portrait.jpg")
canvas.save(out, "JPEG", quality=90, optimize=True)
print(out, canvas.size, out.stat().st_size)
